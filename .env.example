# ── Mode ───────────────────────────────────────────────────────────────
FITHER_MODE=local            # local | hosted
COACH_ENGINE=agent-sdk       # agent-sdk | api | mock   (local default: agent-sdk, hosted default: mock)
PORT=8787

# ── LLM ────────────────────────────────────────────────────────────────
# FORBIDDEN when FITHER_MODE=local — it silently overrides subscription auth.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
API_DAILY_CALL_CAP=50

# ── LINE ───────────────────────────────────────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Storage ────────────────────────────────────────────────────────────
SQLITE_PATH=./data/fither.db

# ── Web ────────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8787
VITE_DEMO_POLISH=false
