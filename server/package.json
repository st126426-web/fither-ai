{
  "name": "@fither/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/node.ts",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "seed": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "sim": "tsx scripts/simulate.ts",
    "richmenu": "tsx scripts/richmenu-setup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute fither --file=src/storage/schema.sql --remote",
    "verify:agent": "tsx scripts/verify-agent-sdk.ts",
    "sim:onboard": "tsx scripts/sim-onboard.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.5",
    "@anthropic-ai/sdk": "^0.65.0",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
